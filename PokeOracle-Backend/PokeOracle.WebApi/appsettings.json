{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Construir el catálogo lanza cientos de peticiones y cada una emite dos líneas.
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PokeApi": {
    "BaseAddress": "https://pokeapi.co/api/v2/",
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequests": 8,
    "MaxAttempts": 3,
    "RetryBaseDelayMilliseconds": 400,
    "ItemScanLimit": 600
  }
}
