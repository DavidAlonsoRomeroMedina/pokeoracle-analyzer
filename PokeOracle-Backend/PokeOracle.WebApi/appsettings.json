{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PokeOracle": "Data Source=Data/pokeoracle.db"
  },
  "PokeApi": {
    "BaseAddress": "https://pokeapi.co/api/v2/",
    "PokemonCount": 1025,
    "RequestTimeoutSeconds": 60,
    "MaxConcurrentRequests": 6,
    "MaxAttempts": 5,
    "RetryBaseDelayMilliseconds": 500,
    "PokemonSaveBatchSize": 40,
    "ItemScanLimit": 800,
    "MoveScanLimit": 0
  }
}
